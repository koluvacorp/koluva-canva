{
  "name": "koluva-canva",
  "productName": "Koluva Canva",
  "version": "1.0.0",
  "description": "Editor gráfico completo para Windows: diseños, presentaciones y animaciones, sin cuenta y sin nube.",
  "author": "Koluva",
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "sync": "node tools/sync-www.cjs",
    "start": "node tools/sync-www.cjs && electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "node tools/sync-www.cjs && electron-builder --win nsis --x64 --publish never",
    "release:manifest": "node tools/create-update-manifest.cjs",
    "release:publish": "node tools/publish.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.koluva.canva",
    "productName": "Koluva Canva",
    "artifactName": "KoluvaCanva-${version}-Windows-${arch}-Setup.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "release.config.json",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "KoluvaCanva"
    },
    "fileAssociations": [
      {
        "ext": "kcanva",
        "name": "Proyecto de Koluva Canva",
        "description": "Proyecto de Koluva Canva",
        "icon": "build/icon.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Koluva Canva",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "es",
        "en",
        "fr",
        "pt_BR"
      ],
      "language": "3082"
    }
  }
}